rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 'finance' is a lighter role than admin — it can only read confirmed
    // registrations (for the revenue report) and the audit log stays
    // admin-only, so this is deliberately not granted anywhere else below.
    function isFinance() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'finance';
    }

    // Throttles joinQueue's create/re-register writes (see registrations
    // below) to at most one every few seconds per user, guarding against a
    // scripted spam loop. exists() is checked before get() since a
    // brand-new user has no rateLimits doc yet, and get() throws (rather than
    // returning null) for a document that isn't there.
    function rateLimitOk(uid) {
      return !exists(/databases/$(database)/documents/rateLimits/$(uid)) ||
        request.time > get(/databases/$(database)/documents/rateLimits/$(uid)).data.lastActionAt + duration.value(5, 's');
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == 'user';
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role;
      allow update: if isAdmin();
    }

    match /marathons/{marathonId} {
      // Non-drafts stay readable even after an event closes, so a registrant
      // keeps seeing their event's details (banner, date, payment info) on
      // their My Registrations view after registration closes.
      allow read: if isSignedIn() &&
        (resource.data.status != 'draft' || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /questionnaireTemplates/{templateId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /legalContent/{docId} {
      // Public — powers /terms and /privacy, which must render for
      // signed-out visitors too (see App.tsx's routes and LegalPageLayout).
      allow read: if true;
      allow write: if isAdmin();
    }

    match /registrations/{registrationId} {
      // `resource` is null for a registration id that doesn't exist yet — e.g.
      // joinQueue()'s existence check (getDoc at the deterministic id) before
      // ever creating a doc there. resource.data would throw on a null
      // resource instead of just reporting "not found", so that has to
      // short-circuit via `resource == null` before it's referenced.
      // The finance branch only ever matches 'confirmed' docs, which lines up
      // exactly with the revenue report's own query filter (status ==
      // 'confirmed') — required for Firestore to prove an unfiltered-by-user
      // collection query is safe (see subscribeToAllMarathons for the same
      // pattern).
      allow read: if isSignedIn() &&
        (resource == null || resource.data.userId == request.auth.uid || isAdmin() ||
          (isFinance() && resource.data.status == 'confirmed'));

      // One registration per (user, marathon, cycle): the doc id is required
      // to be that exact composite key, so a second "join" attempt against
      // the same marathon/cycle always lands on the update rule below
      // instead of being able to create a sibling queue entry. Also gated on
      // the marathon actually being published, so a user can't queue against
      // a draft event before it's announced.
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'queued' &&
        registrationId == request.auth.uid + '_' + request.resource.data.marathonId + '_' + string(request.resource.data.cycle) &&
        get(/databases/$(database)/documents/marathons/$(request.resource.data.marathonId)).data.status == 'published' &&
        rateLimitOk(request.auth.uid);

      // A rejected or self-cancelled registration may be re-registered by its
      // owner — reset back to a fresh queue entry on the SAME doc rather than
      // ever creating a second one for this marathon/cycle (see the
      // deterministic doc id on the create rule above). Only while the
      // marathon is still published, mirroring the create rule, and every
      // pipeline field a fresh joinQueue() write would set is reset together.
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        resource.data.status in ['rejected', 'cancelled'] &&
        request.resource.data.status == 'queued' &&
        get(/databases/$(database)/documents/marathons/$(resource.data.marathonId)).data.status == 'published' &&
        rateLimitOk(request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'packageId', 'packageName', 'packagePriceAmount', 'packagePriceCurrency',
            'selectedAddOns', 'offeredPackageIds', 'status', 'queuePosition', 'queueSortAt', 'termsAcceptedAt', 'answers',
            'proofOfPaymentUrls', 'proofSubmittedAt', 'paymentReference', 'adminNote', 'cancelledAt',
            'depositPaidAt', 'depositProofUrls', 'depositProofSubmittedAt', 'approvedPaymentReferences', 'finalInvoice', 'previousFinalInvoices',
            'finalTermsAcceptedAt', 'createdAt', 'updatedAt',
          ]);

      // User may only progress their own registration through the
      // acceptance wizard one step at a time — from the exact prior status
      // that step expects, touching only the fields that step's client code
      // actually writes (see submitTermsAndConditions/submitProofOfPayment
      // in features/registrations/api.ts). Never set admin-controlled
      // outcomes (accepted/rejected/confirmed), and never forge unrelated
      // fields (marathonId, adminNote, queuePosition, ...) while making a
      // step's legitimate write. The package price snapshot is client-written
      // at offer acceptance (as it was at join before the waitlist flow);
      // admins see it at payment review and build the final invoice anyway.
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        (
          // Accepting the offer also picks the package — only one the admin
          // offered (legacy offers without offeredPackageIds keep the package
          // chosen at join time).
          (resource.data.status == 'accepted' &&
            request.resource.data.status == 'terms_accepted' &&
            request.resource.data.packageId in resource.data.get('offeredPackageIds', [resource.data.packageId]) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'status', 'termsAcceptedAt', 'updatedAt', 'packageId', 'packageName',
                'packagePriceAmount', 'packagePriceCurrency', 'selectedAddOns',
              ])) ||
          (resource.data.status in ['terms_accepted', 'payment_rejected'] &&
            request.resource.data.status == 'payment_submitted' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'proofOfPaymentUrls', 'proofSubmittedAt', 'paymentReference', 'updatedAt'])) ||
          // Balance proof against the final invoice, accepting its T&C in the same write.
          (resource.data.status == 'final_invoiced' &&
            request.resource.data.status == 'payment_submitted' &&
            request.resource.data.finalTermsAcceptedAt == request.time &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'proofOfPaymentUrls', 'proofSubmittedAt', 'paymentReference', 'finalTermsAcceptedAt', 'updatedAt'])) ||
          // The passport bio page and questionnaire come last, once the booking is confirmed. Submitted
          // answers are read-only: a later write may only add answers (e.g. to a question added afterwards).
          (resource.data.status == 'confirmed' &&
            request.resource.data.status == 'confirmed' &&
            request.resource.data.get('answers', []).hasAll(resource.data.get('answers', [])) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'passportPhotoUrl', 'updatedAt']))
        );

      allow update: if isAdmin();
    }

    match /rateLimits/{uid} {
      // Sole purpose: a per-user "last queue action" timestamp read by
      // rateLimitOk() above. lastActionAt must equal the server's own
      // request time — a client can never backdate it to fake a cooldown
      // that already elapsed.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['lastActionAt']) &&
        request.resource.data.lastActionAt == request.time;
    }

    match /personalThreads/{userId} {
      allow read, create, update: if isSignedIn() && (userId == request.auth.uid || isAdmin());
    }

    match /personalThreads/{userId}/messages/{messageId} {
      allow read: if isSignedIn() && (userId == request.auth.uid || isAdmin());

      // Messages are immutable once created — no update/delete rule.
      allow create: if isSignedIn() &&
        (userId == request.auth.uid || isAdmin()) &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.senderRole == (isAdmin() ? 'admin' : 'user');
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      // Admin-only, and immutable once written — no update/delete rule, so
      // even an admin can't edit or erase an existing entry, only add new ones.
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorId == request.auth.uid;
    }

    match /groupMessages/{messageId} {
      allow read: if isSignedIn();

      // Messages are immutable once created — no update/delete rule.
      allow create: if isSignedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.senderRole == (isAdmin() ? 'admin' : 'user');
    }
  }
}
