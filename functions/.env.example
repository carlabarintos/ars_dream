# Bucket the nightly scheduledFirestoreBackup function exports to (see
# scheduled-backup.ts for the one-time bucket/IAM setup this requires).
# Not secret — GCS bucket names are not sensitive — so the real value lives in
# a committed functions/.env.<project-id> file (e.g. functions/.env.arsdream-1f00f),
# loaded automatically by firebase-tools at deploy time.
FIRESTORE_BACKUP_BUCKET=
