rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /proof-of-payment/{registrationId}/{fileName} {
      function registration() {
        return firestore.get(/databases/(default)/documents/registrations/$(registrationId)).data;
      }

      function isOwner() {
        return request.auth != null && registration().userId == request.auth.uid;
      }

      // Only the registrant who owns this registration may upload their own
      // proof of payment; admins (and the owner) may read it back for review.
      allow read: if isOwner() || isAdmin();
      allow write: if isOwner() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Passport bio page photos — private to the registrant and admins, like proof of payment.
    match /passports/{registrationId}/{fileName} {
      function isOwner() {
        return request.auth != null &&
          firestore.get(/databases/(default)/documents/registrations/$(registrationId)).data.userId == request.auth.uid;
      }

      allow read: if isOwner() || isAdmin();
      allow write: if isOwner() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Marathon and announcement banners are public-facing images shown to
    // every signed-in user (timeline, home feed) — only admins may upload them.
    match /marathon-banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /announcement-banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Per-package photos (e.g. room photos for a "Standard" package) shown as a
    // carousel on the package selection page — public-facing like the banners above.
    match /marathon-packages/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Each package's "standard offer" image, previewed by an admin and sendable to a
    // registrant via chat when accepting them — public-facing like the photos above.
    match /marathon-package-offers/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
